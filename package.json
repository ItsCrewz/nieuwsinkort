{
  "name": "nieuwsinkort-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "bronnen": "node scripts/build-bronnen.mjs",
    "build": "node scripts/build-bronnen.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "export": "node export_from_canvas.mjs",
    "deploy": "bash deploy.sh",
    "test": "esbuild tests/dedup.test.ts --bundle --platform=node --format=esm --outfile=/tmp/nik-test.mjs --log-level=warning && node /tmp/nik-test.mjs && esbuild tests/filters.test.ts --bundle --platform=node --format=esm --outfile=/tmp/nik-filters-test.mjs --log-level=warning && node /tmp/nik-filters-test.mjs"
  },
  "dependencies": {
    "hls.js": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "wrangler": "^3.114.17"
  }
}
