{
  "name": "nieuwsinkort-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "bash scripts/check.sh",
    "bronnen": "node scripts/build-bronnen.mjs",
    "build": "node scripts/build-bronnen.mjs && tsc --noEmit && vite build && node scripts/build-version.mjs",
    "preview": "vite preview --port 4173",
    "export": "node export_from_canvas.mjs",
    "deploy": "bash deploy.sh",
    "test": "node scripts/run-tests.mjs",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "changelog": "node scripts/changelog.mjs",
    "coverage": "vitest run --coverage && node scripts/coverage-groepen.mjs"
  },
  "dependencies": {
    "hls.js": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.28.2",
    "html-validate": "^11.17.0",
    "postcss": "^8.4.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
