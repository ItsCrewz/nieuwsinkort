# Alleen namen, geen waarden. Kopieer naar .env (staat in .gitignore) en vul lokaal in.

# --- Geheimen ---
CLOUDFLARE_API_TOKEN=
# RUN_KEY is een Worker-secret: zet die met `wrangler secret put RUN_KEY`, niet via dit bestand.
RUN_KEY=

# --- Cloudflare / deploy (deploy.sh) ---
CLOUDFLARE_ACCOUNT_ID=
CF_PAGES_PROJECT=
DEPLOY_WORKER=
DRY_RUN=
SKIP_BUILD=
FROZEN_BRANCH=

# --- Scripts ---
CANVAS_SRC=
# Standaard scripts/pipeline/feeds.json; extern pad geeft een waarschuwing.
FEEDS_JSON=
FILMPJES_PY=

# --- Worker-vars (staan in worker/wrangler.toml [vars], hier alleen ter info) ---
# SITE
# MODEL
# SMALL_MODEL
# CAP
# BUDGET
